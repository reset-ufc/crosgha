#!/usr/bin/env bash
# Rejects commit messages that are not Conventional Commits.
# https://www.conventionalcommits.org/en/v1.0.0/
set -euo pipefail

msg_file="$1"
# Git runs this hook before dropping blank and comment lines; stripspace drops them the same way,
# honoring core.commentChar, so the subject is the line git will store.
first_line="$(git stripspace --strip-comments < "$msg_file" | head -n 1)"

# Git wraps a subject in `Revert "…"` or `Reapply "…"`, and `commit --fixup/--squash/--amend`
# prefixes it with a marker that `rebase --autosquash` folds away; the wrapped subject must
# still pass.
subject="$first_line"
while :; do
    case "$subject" in
        "fixup! "*|"squash! "*|"amend! "*) subject="${subject#*! }" ;;
        'Revert "'*'"'|'Reapply "'*'"') subject="${subject#* \"}"; subject="${subject%\"}" ;;
        *) break ;;
    esac
done

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
pattern="^($types)(\\([a-zA-Z0-9_./-]+\\))?!?: .+"
# Merge subjects git and GitHub generate.
merge="^Merge (((branch|branches|remote-tracking branch|tag|commit) '.+)|(pull request #[0-9]+ from .+))"

if [[ ! "$subject" =~ $pattern && ! "$subject" =~ $merge ]]; then
    echo "commit-msg: rejected — not a Conventional Commit." >&2
    echo "  got:      $first_line" >&2
    echo "  expected: <type>(<scope>)?!: <description>" >&2
    echo "  types:    $types" >&2
    echo "  example:  feat(cli): add --version flag" >&2
    exit 1
fi
