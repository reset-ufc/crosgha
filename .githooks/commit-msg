#!/usr/bin/env bash
# Rejects commit messages that are not Conventional Commits.
# https://www.conventionalcommits.org/en/v1.0.0/
set -euo pipefail

msg_file="$1"
first_line="$(head -n1 "$msg_file")"

# Messages git writes itself: merges, reverts, and `commit --fixup/--squash` markers that
# `rebase --autosquash` folds away.
case "$first_line" in
    "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'
pattern="^($types)(\\([a-zA-Z0-9_./-]+\\))?!?: .+"

if [[ ! "$first_line" =~ $pattern ]]; then
    echo "commit-msg: rejected — not a Conventional Commit." >&2
    echo "  got:      $first_line" >&2
    echo "  expected: <type>(<scope>)?!: <description>" >&2
    echo "  types:    $types" >&2
    echo "  example:  feat(cli): add --version flag" >&2
    exit 1
fi
