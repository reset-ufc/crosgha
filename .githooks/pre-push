#!/usr/bin/env bash
# Fails fast on fmt, clippy, and test regressions before a push.
set -euo pipefail

# Callers such as `gh repo create --push` or IDEs run without mise activated, so cargo would use rustup's default
# toolchain instead of the one pinned in mise.toml.
if [[ -z "${CROSGHA_HOOK_IN_MISE:-}" ]] && command -v mise >/dev/null; then
  CROSGHA_HOOK_IN_MISE=1 exec mise exec -- "$0" "$@"
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

echo "pre-push: cargo fmt --check"
cargo fmt --check

echo "pre-push: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "pre-push: cargo test"
cargo test

echo "pre-push: crosgha dogfood"
cargo run -- --offline --persona pedantic .github/workflows

echo "pre-push: all checks passed"
